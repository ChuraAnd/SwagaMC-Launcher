	quest.00F9A58636A5ACB9.title: "Спуститься в ад"
	quest.02DE84D45ADC5DEE.quest_desc: [
		"Кристал можно вырастить из потрескавшихся блоков истинного кварца которые находятся внутри метиоритов"
		""
		""
		"Безупречный блок истинного кварца не деградирует с выращеными кристалами так что будьте с ним аккуратней"
		"добыть его можно при помощи глифа гравитация из арс нова поставив под блок полублок либо факел"
	]
	quest.032A91C7DEA260E4.quest_desc: [
